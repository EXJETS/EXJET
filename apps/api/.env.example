# Names only. Copy to .env and fill in locally. Never commit real values.
EXJET_ENV=                          # REQUIRED, no default: dev | test | staging | prod (startup fails if unset or unknown)
EXJET_DATABASE_URL=
EXJET_PII_KEY=                      # Fernet key; required outside dev/test
EXJET_JWT_SECRET=                   # required outside dev/test
EXJET_SESSION_MINUTES=720
EXJET_APP_BASE_URL=
EXJET_WEB_BASE_URL=
EXJET_CORS_ORIGINS=                 # explicit origins only; '*' is rejected
EXJET_TRUSTED_PROXY_HOPS=0          # reverse proxies in front of the API; >0 trusts that many X-Forwarded-For entries from the right

# Providers: fake providers are used in dev/test; staging/prod refuse to boot on fakes.
EXJET_BILLING_PROVIDER=fake         # fake | stripe (not implemented)
EXJET_KYC_PROVIDER=fake             # fake | stripe_identity (not implemented)
EXJET_MAIL_PROVIDER=fake            # fake | gmail (not implemented)
EXJET_ADSB_PROVIDER=fake            # fake | flightaware (not implemented)
EXJET_WEATHER_PROVIDER=aviationweather   # aviationweather | fake
EXJET_LLM_PROVIDER=none             # none | anthropic
EXJET_STORAGE_PROVIDER=local        # local | s3 (not implemented)
EXJET_STORAGE_DIR=

EXJET_RFQ_FROM_ADDRESS=
EXJET_EXCLUDED_OPERATORS=NetJets,Flexjet,Nicholas Air   # the three baseline names are always excluded; this only adds
EXJET_EXCLUDED_OPERATOR_ALIASES=     # comma separated; founder-supplied trade names / affiliates (empty by default)
EXJET_EXCLUDED_CERTIFICATES=        # comma separated certificate numbers (empty by default)
EXJET_MAX_FUEL_STOPS=
EXJET_MANIFEST_DUE_HOURS=
EXJET_RFQ_DAILY_CAP=40              # per account, rolling 24 h
EXJET_GROUND_RFQ_DAILY_CAP=10
EXJET_SEAT_INVITE_TTL_HOURS=72
EXJET_PASSWORD_RESET_TTL_MINUTES=30
EXJET_PDF_MAX_BYTES=10485760
EXJET_PDF_MAX_PAGES=50
EXJET_PDF_MAX_CHARS=400000
EXJET_PDF_TIMEOUT_SECONDS=20

# Secrets (only when the matching real provider is selected)
EXJET_STRIPE_SECRET_KEY=
EXJET_STRIPE_WEBHOOK_SECRET=
EXJET_STRIPE_PRICE_INDIVIDUAL=
EXJET_STRIPE_PRICE_FAMILY_OFFICE=
EXJET_ANTHROPIC_API_KEY=
EXJET_LLM_MODEL_FAST=               # model id for parsing; read by the Anthropic provider
EXJET_FLIGHTAWARE_API_KEY=
EXJET_GMAIL_SERVICE_ACCOUNT_JSON=

# Dev seed only
EXJET_SEED_ADMIN_EMAIL=
EXJET_SEED_ADMIN_PASSWORD=
