# Binance API (read-only for alerts mode — no trading permission needed)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional: Binance Futures (for funding rate data)
BINANCE_FUTURES_API_KEY=your_futures_api_key_here
BINANCE_FUTURES_API_SECRET=your_futures_api_secret_here
