EXJET_SECRET=change-me-to-a-long-random-string
EXJET_ADMIN_EMAIL=admin@exjet.com
EXJET_ADMIN_PASSWORD=change-me
EXJET_DEMO=0
EXJET_HTTPS=1
# 1 when the app sits behind one reverse proxy (Render, Railway, Fly). 0 if clients reach it directly.
EXJET_PROXY=1
CHARTER_EMAIL=charter@exjet.com
SALES_EMAIL=sales@exjet.com
EXJET_DB=/data/exjet.db
EXJET_UPLOADS=/data/uploads
# Optional. With these set, emails send for real instead of waiting in the admin outbox.
# SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASS=  MAIL_FROM=charter@exjet.com
